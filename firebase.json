{
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/data",
        "function": "apidata"
      },
      {
        "source": "/api/session",
        "function": "participantapi"
      },
      {
        "source": "/api/condition",
        "function": "participantapi"
      },
      {
        "source": "/api/base64",
        "function": "apidata"
      },
      {
        "source": "/api/oauth2callback",
        "function": "dashboardapi"
      },
      {
        "source": "/api/checkemailconflict",
        "function": "dashboardapi"
      },
      {
        "source": "/api/generateoauthstate",
        "function": "dashboardapi"
      },
      {
        "source": "/api/saveosftoken",
        "function": "dashboardapi"
      },
      {
        "source": "/api/queuestatus",
        "function": "apiqueuestatus"
      },
      {
        "source": "/api/createexperiment",
        "function": "dashboardapi"
      },
      {
        "source": "/api/connectprovider",
        "function": "dashboardapi"
      },
      {
        "source": "/api/connectstatictokenprovider",
        "function": "dashboardapi"
      },
      {
        "source": "/api/disconnectprovider",
        "function": "dashboardapi"
      },
      {
        "source": "/api/getprovideraccesstoken",
        "function": "dashboardapi"
      },
      {
        "source": "/api/providersetupwarnings",
        "function": "dashboardapi"
      },
      {
        "source": "/api/deleteaccount",
        "function": "dashboardapi"
      },
      {
        "source": "/api/finalize",
        "function": "dashboardapi"
      },
      {
        "source": "/api/ensurederivedpaths",
        "function": "dashboardapi"
      },
      {
        "source": "/api/clearerrors",
        "function": "dashboardapi"
      },
      {
        "source": "/api/sendcontactemailverification",
        "function": "dashboardapi"
      },
      {
        "source": "/api/verifycontactemail",
        "function": "dashboardapi"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "localhost"
    },
    "functions": {
      "port": 5001,
      "host": "localhost"
    },
    "firestore": {
      "port": 8080,
      "host": "localhost"
    },
    "database": {
      "port": 9000,
      "host": "localhost"
    },
    "hosting": {
      "port": 5000,
      "host": "localhost"
    },
    "storage": {
      "port": 9199,
      "host": "localhost"
    },
    "ui": {
      "enabled": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
