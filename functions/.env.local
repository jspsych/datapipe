# Emulator-only overrides for local dev and the CI test suite.
#
# Firebase loads this file ONLY when running the emulators; it is never
# included in `firebase deploy`. That is exactly why the Google Drive mock
# values live here instead of in .env.datapipe-test -- keeping them out of
# the deployed test site (see .env.datapipe-test for the real values).
#
# It is intentionally committed (see the `!functions/.env.local` exception
# in the root .gitignore) so `npm test` / `firebase emulators:exec` work from
# a fresh checkout, in CI and locally, with no extra setup. Every value here
# is a non-secret test dummy. The oauth-connect / gdrive emulator tests
# assert against these exact values and mock servers bind the fixed ports
# below, so keep them in sync with those tests.
GDRIVE_API_BASE=http://127.0.0.1:3579
GDRIVE_TOKEN_URL=http://127.0.0.1:3580/token
# Same mock server as GDRIVE_TOKEN_URL above (port 3580) -- disconnectProvider
# revokes the stored refresh token through this route when a gdrive
# connection is removed, and oauth-connect-emulator.test.js's mock server
# asserts on what it received. purge-user-data-emulator.test.js calls
# purgeUserData in-process rather than through this spawned Functions
# emulator, so it points GDRIVE_REVOKE_URL at its own OS-assigned-port mock
# instead -- this value never reaches that suite.
GDRIVE_REVOKE_URL=http://127.0.0.1:3580/revoke
GDRIVE_AUTHORIZE_URL=http://127.0.0.1:3580/authorize
GDRIVE_CLIENT_ID=test-client-id
GDRIVE_CLIENT_SECRET=test-client-secret
GDRIVE_REDIRECT_URI=http://localhost:3000/oauth2/connect

# Redirects every Zenodo call to zenodo-emulator.test.js's mock (port 3581).
# Zenodo's adapter allowlists zenodo.org/sandbox.zenodo.org, so unlike gdrive
# this is not merely a convenience -- there is no other way to reach a local
# mock. zenodo.ts only reads it when FUNCTIONS_EMULATOR=true, so it cannot
# take effect on a deployed function even if it leaked into a deploy.
ZENODO_API_BASE=http://127.0.0.1:3581

# Names the one origin dataverse.ts's resolveServerUrl allows through
# isAllowedServerUrl's SSRF allowlist unchecked -- dataverse-emulator.test.js's
# mock (port 3582), seeded directly into the experiment's providerContainer
# and the stored connection rather than read from an env var (Dataverse is
# federated, so unlike Zenodo there is no single provider-constant serverUrl
# to redirect; see isAllowedMockOrigin's comment in dataverse.ts for why this
# is a narrower seam than ZENODO_API_BASE above). dataverse.ts only reads it
# when FUNCTIONS_EMULATOR=true, so it cannot take effect on a deployed
# function even if it leaked into a deploy, and even then it exempts only this
# exact origin -- every other loopback/private address a tampered
# providerContainer.serverUrl could name is still refused.
DATAVERSE_MOCK_ORIGIN=http://127.0.0.1:3582
TOKEN_ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab

# Which Realtime Database namespace the staging tier uses under the emulator
# (functions/src/staging.ts, stagingDatabaseURL). Pinned because the emulator
# disagrees with itself while the project has no RTDB instance: it loads
# database.rules.json into `<project>-default-rtdb`, but hands functions a
# FIREBASE_CONFIG.databaseURL for namespace `<project>` -- so without this the
# functions stage into a namespace with no rules and no `.indexOn`, and the
# abandonment sweep's query fails outright. Once an instance exists both sides
# say `<project>-default-rtdb` (every default instance is named that, in any
# region), so this stays correct after provisioning too.
#
# Not FIREBASE_DATABASE_URL: the FIREBASE_ prefix is reserved and firebase-tools
# rejects any .env key starting with it.
STAGING_DATABASE_URL=http://127.0.0.1:9000/?ns=datapipe-test-default-rtdb

# Redirects every OSF accounts.osf.io / api.osf.io call oauth2-callback.ts
# makes to oauth2-callback-emulator.test.js's mock. Same reason as
# ZENODO_API_BASE: oauth2-callback.ts's handler runs inside the Functions
# emulator's own process, a separate process from the jest test file that
# calls it over HTTP, so there is no in-process fetch/nock seam reachable
# from a test -- this is the only way to reach a local mock. One mock server
# answers both the accounts.* and api.* paths, so a single override origin
# covers both. oauth2-callback.ts only reads it when FUNCTIONS_EMULATOR=true,
# so it cannot take effect on a deployed function even if it leaked into a
# deploy.
#
# Port 3591, distinct from every fixed mock-server port already in use
# (3579-3583, 3590 -- see compaction-emulator.test.js, gdrive-emulator.test.js,
# oauth-connect-emulator.test.js, dataverse-emulator.test.js,
# zenodo-emulator.test.js, finalization-emulator.test.js) so this suite can
# run concurrently with them.
OSF_API_BASE_OVERRIDE=http://127.0.0.1:3591
